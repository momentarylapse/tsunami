use config.*
use tsunami.*
use helper.draw.*
use hui
use profiledialog.*



# the basic UI panel
class MandalaPanel extends ConfigPanel
	#override c: Mandala&
	var config: MandalaConfig&
	var source_selector: owned![DeviceSelector]
	var width, height: i32
	
	struct HoverInfo
		enum Type
			SURFACE
			RIM
			SAVE_SURFACE_PRESET
			SAVE_RIM_PRESET
		type: Type
		index: i32
	
	var hover: HoverInfo?
	
	func override __init__(_s: Module)
		for cc in c.get_config()
			config := &cc as MandalaConfig&
		
		# define the ui elements
		from_source("
Grid grid ''
	Grid ? ''
		Label ? '' expandx
		Button expand '↓'
		Button collapse '↑' hidden
	---|
	Expander expander ''
		Grid ? ''
			Label ? 'Profile'
			Grid ? ''
				ComboBox surface-profile '' 'tooltip=Surface profile' expandx
				ComboBox rim-profile '' 'tooltip=Rim profile' expandx
				Button edit-profiles '' 'tooltip=Profile editing dialog' image=hui:edit noexpandx
			---|
			Label ? 'Device'
			ComboBox source '' 'tooltip=Mandala midi input device' expandx
			---|
			Label ? 'Zones'
			ComboBox number-of-zones '1\\2\\4' 'tooltip=Splitting the surface into 1, 2 or 4 zones' expandx
	---|
	DrawingArea area '' expandx expandy")
	
		source_selector = new DeviceSelector(self, "source", c.session, Device.Type.MIDI_INPUT, on_source)
		
		event("number-of-zones", on_number_of_zones)
		event("rim-profile", on_rim_profile)
		event("surface-profile", on_surface_profile)
		event_x("area", "hui:draw", on_draw)
		event_x("area", "hui:mouse-move", on_mouse_move)
		event_x("area", "hui:left-button-down", on_left_button_down)
		event_x("area", "hui:mouse-leave", on_mouse_leave)
		event("edit-profiles", on_edit_profiles)
		event("expand", on_expand)
		event("collapse", on_collapse)
	
	func mut on_expand()
		hide_control("expand", true)
		hide_control("collapse", false)
		expand("expander", true)
	
	func mut on_collapse()
		hide_control("expand", false)
		hide_control("collapse", true)
		expand("expander", false)
	
	func override update()
		set_int("number-of-zones", clamp(config.number_of_zones, 1, 3) - 1)
		redraw("area")
		
		reset("rim-profile")
		for i=>p in config.rim_profiles
			add_string("rim-profile", p.name)
			for name in config.current_rim_profile
				if p.name == name
					set_int("rim-profile", i)
		reset("surface-profile")
		for i=>p in config.surface_profiles
			add_string("surface-profile", p.name)
			for name in config.current_surface_profile
				if p.name == name
					set_int("surface-profile", i)
	
	func mut on_number_of_zones()
		let n = get_int("number-of-zones")
		config.number_of_zones = 2^n
		changed()
		redraw("area")
	
	func mut on_rim_profile()
		let n = get_int("rim-profile")
		if n < 0
			return
		config.apply_rim_profile(config.rim_profiles[n])
		changed()
		
	func mut on_surface_profile()
		let n = get_int("surface-profile")
		if n < 0
			return
		config.apply_surface_profile(config.surface_profiles[n])
		changed()
	
	func mut on_source()
		config.device = source_selector.get()
		
		changed()
	
	
	func draw_hollow_circle(p: hui.Painter, center: vec2, r0: f32, r1: f32)
		var v: vec2[]
		let N = 128
		for i in 0:N+1
			let phi = f32(i) / N * pi * 2
			v.add(center + vec2(cos(phi) * r0, sin(phi) * r0))
		for i in 0:N+1
			let phi = f32(N - i) / N * pi * 2
			v.add(center + vec2(cos(phi) * r1, sin(phi) * r1))
		p.draw_polygon(v)
	
	
	func mut on_draw(p: hui.Painter)
		width = p.width
		height = p.height
		
		p.set_color(theme.background)
		p.draw_rect([0,width, 0,height])
		
		
		# left: surfaces
		let c1 = vec2(width / 4, height / 2)
		let r = min(c1.x, c1.y) * 0.9
		draw_surface_pad(p, c1, r)
		
		
		# right: rims
		let c2 = vec2(width * 3 / 4, height / 2)
		draw_rim_pad(p, c2, r)
		
		# save icon
		p.set_color(theme.text_soft2)
	#	p.set_fill(false)
	#	p.draw_polygon([[8,height-8],[8,height-25],[20,height-25],[25,height-20],[25,height-8]])
	#	p.draw_polygon([[width-25,height-8],[width-25,height-25],[width-13,height-25],[width-8,height-20],[width-8,height-8]])
	#	p.set_fill(true)
		p.draw_str([10, height-15], "S")
		
		p.draw_str([width-20, height-15], "S")
		
		
		# tooltip
		for h in hover
			var tip = ""
			match h.type
				HoverInfo.Type.SURFACE => tip = "Surface #{{h.index+1}}\nsample: {{sample_name(config.surface_samples[h.index])}}"
				HoverInfo.Type.RIM => tip = "Rim #{{h.index+1}}\nsample: {{sample_name(config.rim_samples[h.index])}}"
				HoverInfo.Type.SAVE_SURFACE_PRESET => tip = "Save surface profile"
				HoverInfo.Type.SAVE_RIM_PRESET => tip = "Save rim profile"
			draw_cursor_hover(p, tip, hui.get_event().mouse, [0,width, 0,height])
	
	
	func mut draw_surface_pad(p: hui.Painter, c1: vec2, r: f32)
		let group_size = config.group_size()
		
		for i in 0:NSURFACES
			if (i % group_size) == 0
				var hovering = false
				for h in hover
					if h.type == HoverInfo.Type.SURFACE and h.index >= i and h.index < i + group_size
						hovering = true
				let alpha = if hovering
					0.6
				else
					0.3
				p.set_color(theme.neon(4 - i).with_alpha(alpha))
				let r0 = r/NSURFACES*i
				let r1 = r/NSURFACES*(i+group_size)
				draw_hollow_circle(p, c1, r0, r1)
				let fs = if hovering
					11.0
				else
					9.0
				let p0 = c1 + vec2(0, -r0 - r/NSURFACES/2)
				if not weak(config.surface_samples)[i]
					p.set_color([0.9,0,0, 1])
					p.set_line_width(1.5)
					p.draw_line(p0 + vec2(-fs*0.5,-fs*0.6), p0 + vec2(fs*0.5,fs*0.6))
					p.draw_line(p0 + vec2(-fs*0.5,fs*0.6), p0 + vec2(fs*0.5,-fs*0.6))
				p.set_color(theme.text)
			#	if hovering
			#		p.set_color(theme.text)
			#		fs = 10.0
				p.set_font_size(fs)
				p.draw_str(p0 + vec2(-fs*0.3, - fs*0.4), str(i+1))
		p.set_fill(false)
		p.set_color(theme.text)
		p.draw_circle(c1, r)
		if config.number_of_zones == 4
			p.draw_circle(c1, r*0.75)
		if config.number_of_zones != 1
			p.draw_circle(c1, r*0.5)
		if config.number_of_zones == 4
			p.draw_circle(c1, r*0.25)
		
		p.set_fill(true)
		p.set_color(theme.text_soft2)
		for name in config.current_surface_profile
			var s = name
			if not config.is_surface_profile_saved()
				s += " *"
			p.draw_str([10,10], s)
			
			
	func mut draw_rim_pad(p: hui.Painter, c2: vec2, r: f32)
		p.set_color(theme.neon(4).with_alpha(0.3))
		p.set_fill(true)
		p.draw_circle(c2, r)
		p.set_fill(false)
		p.set_color(theme.text)
		p.draw_circle(c2, r)
		p.set_fill(true)
		p.set_font_size(8)
		for i in 0:NRIMS
			var hovering = false
			for h in hover
				if h.type == HoverInfo.Type.RIM and h.index == i
					hovering = true
					
			# outer tick
			let phi = f32(i) / NRIMS * 2 * pi
			p.set_color(theme.text)
			p.draw_circle(c2 + r * vec2(sin(phi), -cos(phi)), 5)
			
			# number
			let phi2 = phi + pi / NRIMS
			let fs = if hovering
				12.0
			else
				9.0
			let p0 = c2 + (r - 13) * vec2(sin(phi2), -cos(phi2))
			if not weak(config.rim_samples)[i]
				p.set_color([0.9,0,0, 1])
				p.set_line_width(1.5)
				p.draw_line(p0 + vec2(-fs*0.5,-fs*0.6), p0 + vec2(fs*0.5,fs*0.6))
				p.draw_line(p0 + vec2(-fs*0.5,fs*0.6), p0 + vec2(fs*0.5,-fs*0.6))
		#	p.set_color(theme.text_soft1)
		#	if hovering
			p.set_color(theme.text)
			p.set_font_size(fs)
			p.draw_str(p0 + vec2(-fs*0.3,-fs*0.4), str(i+1))
		
		p.set_color(theme.text_soft2)
		for name in config.current_rim_profile
			var s = name
			if not config.is_rim_profile_saved()
				s += " *"
			p.draw_str([width/2 + 30,10], s)
			
			
	func get_hover(m: vec2) -> HoverInfo?
		# left: surfaces
		let c1 = vec2(width / 4, height / 2)
		let r = min(c1.x, c1.y) * 0.9
		
		for i in 0:NSURFACES
			if len(m - c1) < r * f32(i + 1) / f32(NSURFACES)
				return [HoverInfo.Type.SURFACE, i]
		
		
		# right: rims
		let c2 = vec2(width * 3 / 4, height / 2)
		for i in 0:NRIMS
			let phi = (f32(i) + 0.5) / NRIMS * 2 * pi
			let c = c2 + (r - 13) * vec2(sin(phi), -cos(phi))
			if len(m - c) < r * 0.3
				return [HoverInfo.Type.RIM, i]
		
		if m.x < 25 and m.y > height - 25
			return [HoverInfo.Type.SAVE_SURFACE_PRESET, 0]
		if m.x > width - 25 and m.y > height - 25
			return [HoverInfo.Type.SAVE_RIM_PRESET, 0]
		
		return nil
	
	
	func mut on_mouse_move()
		hover = get_hover(hui.get_event().mouse)
		redraw("area")
	
	func mut on_mouse_leave()
		hover = nil
		redraw("area")

	func mut on_left_button_down()
		for h in hover
			match h.type
				HoverInfo.Type.SURFACE =>
					let i = h.index
					var old: Sample* = nil
					for s in config.surface_samples[i]
						old = &s.origin
					let f = func(ss: Sample*)
						for _s in ss
							config.surface_samples[i] = _s.create_ref()
						else
							config.surface_samples[i] = nil
						changed()
					SelectSample(c.session, self, old).then(f)
				HoverInfo.Type.RIM =>
					let i = h.index
					var old: Sample* = nil
					for s in config.rim_samples[i]
						old = &s.origin
					let f = func(ss: Sample*)
						for _s in ss
							config.rim_samples[i] = _s.create_ref()
						else
							config.rim_samples[i] = nil
						changed()
					SelectSample(c.session, self, old).then(f)
				HoverInfo.Type.SAVE_SURFACE_PRESET =>
					let f = func(s: string)
						config.save_surface_profile(s)
					ask_preset_name(win, config.surface_profile_names(), true).then(f)
				HoverInfo.Type.SAVE_RIM_PRESET =>
					let f = func(s: string)
						config.save_rim_profile(s)
						changed()
					ask_preset_name(win, config.rim_profile_names(), true).then(f)

	func mut on_edit_profiles()
		hui.fly(new ProfileDialog(&self, config))

